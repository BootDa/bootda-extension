{
  "name": "bootda-extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --config extension/vite.config.ts",
    "build": "vite build --config extension/vite.config.ts && vite build --config extension/vite.config.ts --mode content",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:foundation": "node --test tests/foundation.test.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.3.6",
    "vitest": "^3.2.0"
  }
}
